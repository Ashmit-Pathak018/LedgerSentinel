# ─────────────────────────────────────────────
# LedgerSentinel Model Service — Environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────

# ── Model toggle ─────────────────────────────
# Set to true to return fixture signals instantly (Yashraj's mock contract)
MODELS_MOCK=false

# ── Ollama ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Model identifiers (must match ollama list) ─
# gemma3n:e4b is BROKEN on Ollama 0.33.3 - every prompt returns repeated <unused25> tokens, via
# CLI and API alike, and `ollama show` reports no vision capability in this build either. The
# extract slot points at Qwen instead.
#
# That this is a one-line change is the point: models sit behind a frozen Signal contract, so
# swapping one out does not touch the API, the gate, the UI or the evaluators. Worth saying on
# stage - it is the boundary doing its job.
GEMMA_MODEL=qwen3:4b
QWEN_MODEL=qwen3:4b

# ── Version strings (bump on every fix) ───────
MODEL_VERSION=gemma3n-e4b-v1.0
POLICY_VERSION=v1.0

# ── Calibration ───────────────────────────────
CALIBRATION_SCALER_PATH=calibration/scaler.pkl

# ── Server ────────────────────────────────────
PORT=8000
LOG_LEVEL=info

# ── Demo mode ─────────────────────────────────
# When true, /model/*/score returns pre-cached demo signals (zero latency on stage)
DEMO_CACHE_MODE=false
DEMO_CACHE_PATH=fixtures/demo_cache.json
