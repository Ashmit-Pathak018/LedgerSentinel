# Serve fixture signals instead of calling the model service. Keep this working all build.
MODELS_MOCK=true
MODELS_URL=http://localhost:8000
MODELS_TIMEOUT_SECONDS=12
WEB_ORIGIN=http://localhost:5173

# Supabase (Phase 4). NEVER commit the real values - .env is gitignored.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role bypasses RLS. Authorization must still be enforced in the app layer.
SUPABASE_SERVICE_KEY=
