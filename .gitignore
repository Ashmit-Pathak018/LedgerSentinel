# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.local
npm-debug.log*

# Secrets - never commit these. Supabase keys, model endpoints, anything with a token.
.env.*
!.env.example
secrets.env
*.key
*.pem
# The deployable app.yaml is generated from api/.env by deploy/make_app_yaml.py and carries
# the Supabase service key and the PRISM key in env_variables. Only app.yaml.example is tracked.
app.yaml
# Firebase CLI cache
web/.firebase/

# Models and large artefacts - these live in Ollama or a release, never in git
*.gguf
*.onnx
*.safetensors
*.bin
models/weights/
models/.cache/

# Evaluation output.
# eval/runs/ IS versioned on purpose: v1.json is the before half of the V1->V2 comparison and
# must not be regenerated after the fix lands, or the comparison is destroyed.
eval/out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
