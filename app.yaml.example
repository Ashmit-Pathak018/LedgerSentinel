# App Engine Standard config for the API. This file is the SHAPE only.
#
# The real app.yaml is generated by `python deploy/make_app_yaml.py` from api/.env and is
# gitignored, because env_variables below carry the Supabase service key and the PRISM key.
# Never commit a filled-in app.yaml.
#
# Deploys from the repo root on purpose: api/ imports ../contracts/py and reads ../eval/runs
# (the PRISM screen's run history), so the bundle has to keep that layout. .gcloudignore
# strips web/, model-service/ and everything else the API does not need.
#
#   gcloud app deploy app.yaml --project ledgersentinel-hq

runtime: python312
instance_class: F1            # free-tier class; no billing account required
entrypoint: uvicorn main:app --app-dir api --host 0.0.0.0 --port $PORT

automatic_scaling:
  max_instances: 2
  min_instances: 0             # scale to zero; first hit after idle takes a few seconds

handlers:
  - url: /.*
    script: auto
    secure: always

env_variables:
  MODELS_MOCK: "true"          # the model service needs a GPU; the deployed API serves fixtures
  WEB_ORIGIN: "https://ledgersentinel-hq.web.app"
  SUPABASE_URL: ""
  SUPABASE_ANON_KEY: ""
  SUPABASE_SERVICE_KEY: ""
  PRISMTRACE_API_KEY: ""
  PRISMTRACE_PROJECT_ID: ""
  PRISMTRACE_HOST: "https://prism-api-prod.up.railway.app"
